{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "types": ["node"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "strict": false,
    "ignoreDeprecations": "6.0"
  },
  "include": ["tests/**/*.ts", "pages/**/*.ts", "locators/**/*.json"]
}
